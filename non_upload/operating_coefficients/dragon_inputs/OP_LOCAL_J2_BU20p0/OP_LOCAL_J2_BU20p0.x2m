* Stepwise depletion and create-mode temperature branches
MODULE LIB: NXT: USS: ASM: FLU: EVO: EDI: GREP: DELETE: END: ;
PROCEDURE GEOM37_NXT GEOM37F MATDPLD2O MATOPER ;
LINKED_LIST GEOM GEOMT LIBRAW LIBSS SYS FLUX BURNUP LIBBR LIBB2 SYSB FLUXB GEOMF GEOMTF EDIT ;
SEQ_BINARY TRACKF ;
SEQ_BINARY TRACK ;
REAL Keff CheckD CheckM ;
STRING LibName := "DLIB_J2" ;
GEOM := GEOM37_NXT :: ;
GEOMT TRACK := NXT: GEOM :: ALLG TISO 3 3.0 ;
LIBRAW := MATDPLD2O :: 900.00000 343.15000 343.15000 <<LibName>> ;
LIBSS := USS: LIBRAW GEOMT TRACK :: EDIT 0 GRMIN 0 PIJ ;
SYS := ASM: LIBSS GEOMT TRACK :: PIJ EDIT 0 ;
FLUX := FLU: SYS LIBSS GEOMT TRACK :: EDIT 0 TYPE K THER 5 5E-5 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;
ECHO 'VRF_NOMINAL' 0.0 Keff ;
BURNUP LIBSS := EVO: LIBSS FLUX GEOMT ::
  EDIT 0
  SAVE 0.00000000 DAY POWR 36.80000000
  DEPL 0.00000000 13.58695652 DAY POWR 36.80000000
  SET 13.58695652 DAY ;
