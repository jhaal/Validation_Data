SYS := ASM: LIBSS GEOMT TRACK :: PIJ EDIT 0 ;
FLUX := FLU: SYS LIBSS GEOMT TRACK :: EDIT 0 TYPE K THER 5 5E-5 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;
ECHO 'VRF_NOMINAL' 0.0 Keff ;
